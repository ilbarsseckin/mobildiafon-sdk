<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Ziyaretçi görüntüsü (tam ekran) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/mdRemote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Arayan adı -->
    <TextView
        android:id="@+id/mdCaller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:text="Ziyaretçi"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="8"/>

    <!-- Butonlar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <Button
            android:id="@+id/mdReject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:text="Reddet"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/mdAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:text="Cevapla"
            android:backgroundTint="#43A047"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/mdOpenDoor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:text="Kapıyı Aç"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</FrameLayout>
