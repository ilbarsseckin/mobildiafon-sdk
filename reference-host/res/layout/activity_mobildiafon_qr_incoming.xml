<?xml version="1.0" encoding="utf-8"?>
<!--
  QR (A senaryosu) monitör gelen-çağrı ekranı.
  BÜYÜK (arka, tam ekran)  = kapı paneli kamerası (camera 0, CameraPreview host tarafında eklenir)
  KÜÇÜK (üst-sağ overlay)  = misafirin telefon kamerası (WebRTC SurfaceViewRenderer)
  Küçük görüntüye dokununca tam ekran <-> küçük geçişi (switch).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Kapı paneli kamerası (camera 0) — host CameraPreview'i buraya addView eder -->
    <FrameLayout
        android:id="@+id/mdDoorCam"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Misafir telefon kamerası (WebRTC). Varsayılan küçük overlay. -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/mdRemote"
        android:layout_width="220dp"
        android:layout_height="300dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/mdCaller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#66000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Ziyaretçi"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/mdReject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#E53935"
            android:text="Reddet"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/mdOpenDoor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#1E88E5"
            android:text="Kapı Aç"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/mdAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#43A047"
            android:text="Cevapla"
            android:textColor="@android:color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
